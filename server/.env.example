# ──────────────────────────────────────────────
# Denft Backend — Environment Variables
# ──────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host.neon.tech/denft?sslmode=require"

# Redis (Upstash — optional for local dev, required for production)
# Leave empty to use in-memory fallback in development
REDIS_URL=""

# JWT Secrets (generate with: openssl rand -hex 64)
JWT_SECRET="your-access-token-secret-here"
JWT_REFRESH_SECRET="your-refresh-token-secret-here"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Solana
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_NETWORK="devnet"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Nonce TTL (seconds) — how long a signing challenge is valid
NONCE_TTL=300
